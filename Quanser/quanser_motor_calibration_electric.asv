% Motor electrical equation identification + publication-quality plots
% Calibrates: L * di/dt = v - R*i - ke*omega
% Rearranged for regression: v = L*i_dot + R*i + ke*omega

clear all; close all; clc;

%% ---------- Visual style defaults (LaTeX-friendly, larger fonts) ----------
set(groot, 'defaultTextInterpreter','latex');
set(groot, 'defaultAxesTickLabelInterpreter','latex');
set(groot, 'defaultLegendInterpreter','latex');

defaultFontSize   = 20;
defaultLineWidth  = 1.6;
defaultMarkerSize = 36;

set(groot, 'defaultAxesFontSize', defaultFontSize);
set(groot, 'defaultLineLineWidth', defaultLineWidth);

% Directory
data_dir = 'C:\Users\S4236610\Documents\GitHub\Master-Research-Project\Quanser\motor_calibration_data_shoulder\';

%% File lists
mat_files = {
     'simulink_1Hz_ramp_M1.mat',...
     'simulink_2Hz_ramp_M1.mat',...
};

csv_files = {
     'teensy_1Hz_ramp_M1.csv',...
     'teensy_2Hz_ramp_M1.csv',...
};

%% Hold out test set
test_freq = '2Hz';
train_idx = ~contains(mat_files, test_freq);
test_idx  = ~train_idx;

%% Initialize data arrays
train_v = [];  train_i = [];  train_i_dot = [];  train_omega = [];
test_v  = [];  test_i  = [];  test_i_dot  = [];  test_omega  = [];

% Filter parameters
F = 131;  % Frame length (must be odd)
K = 2;    % Polynomial order
dt = 0.01;

for i = 1:length(mat_files)
    %% Load Teensy data (for alignment reference if needed)
    csv_data = dlmread(fullfile(data_dir, csv_files{i}), ',', 0, 0);
    N_csv = size(csv_data, 1);

    %% Load Simulink data (current, position, voltage)
    S     = load(fullfile(data_dir, mat_files{i}));
    vars  = fieldnames(S);
    data  = S.(vars{1});

    % Column indices:
    % Column 1: Voltage
    % Column 2: Current
    % Column 3: Position (shoulder) / Column 4: Position (elbow)
    v_full = data(:,1);   % Voltage
    I_full = data(:,2);   % Current
    if contains(data_dir, 'elbow')
        p_full = data(:,4);   % Position
    else
        p_full = data(:,3);   % Position
    end

    % Trim to match lengths
    N = min([length(I_full), length(p_full), length(v_full), N_csv]);
    I = I_full(end-N+1:end);
    p = p_full(end-N+1:end);
    v = v_full(end-N+1:end);
    

    %% Signal alignment using cross-correlation (voltage vs current)
%     maxLag = 100;
%     [c, lags] = xcorr(I - mean(I), v - mean(v), maxLag, 'normalized');
%     [~, idx] = max(c);
%     lag = lags(idx)
% 
%     if lag > 0
%         v = v(1:end-lag);
%         I = I(lag+1:end);
%         p = p(lag+1:end);
%     elseif lag < 0
%         I = I(1:end+lag);
%         p = p(1:end+lag);
%         v = v(-lag+1:end);
%     end

    %% Apply Savitzky-Golay filtering
    I_filt = sgolayfilt(I, K, F);
    p_filt = sgolayfilt(p, K, F);

    %% Compute derivatives using Savitzky-Golay differentiation filter
    [~, g] = sgolay(K, F);
    d = flipud(g(:,2)) / dt;  % First derivative coefficients

    % Compute di/dt (current derivative)
    i_dot = conv(I_filt, d, 'same');

    % Compute omega (angular velocity from position)
    omega = conv(p_filt, d, 'same');
    omega = omega;  % Sign convention (adjust if needed)

    %% Trim edge effects from filtering/differentiation
    trim_start = 300;
    trim_end = 100;

    v = v(trim_start:end-trim_end);
    I_filt = I_filt(trim_start:end-trim_end);
    i_dot  = i_dot(trim_start:end-trim_end);
    omega  = omega(trim_start:end-trim_end);

    %% Split into train / test sets
    if train_idx(i)
        train_v       = [train_v;       v];
        train_i       = [train_i;       I_filt];
        train_i_dot   = [train_i_dot;   i_dot];
        train_omega   = [train_omega;   omega];
    else
        test_v        = [test_v;        v];
        test_i        = [test_i;        I_filt];
        test_i_dot    = [test_i_dot;    i_dot];
        test_omega    = [test_omega;    omega];
    end
end

%% ===================== OLS electrical model =====================
% Model: v = L*i_dot + R*i + ke*omega
% Y = v, X = [i_dot, i, omega], Theta = [L, R, ke]

Y = train_v;

% Regressor matrix
X = [train_i_dot, ...   % inductance term
     train_i, ...       % resistance term
     train_omega];      % back-EMF term

% Ordinary Least Squares
Theta_ols = (X' * X) \ (X' * Y);

L_est_ols  = Theta_ols(1);
R_est_ols  = Theta_ols(2);
ke_est_ols = Theta_ols(3);

fprintf('\n=== OLS electrical model ===\n');
fprintf('L  = %.6e H\n', L_est_ols);
fprintf('R  = %.6e Ohm\n', R_est_ols);
fprintf('ke = %.6e V/(rad/s)\n', ke_est_ols);

%% Weighted Least Squares (for heteroscedastic noise)
res0 = (Y - X*Theta_ols).^2;
var_est = movmean(res0, round(0.05*length(Y)));
var_est = max(var_est, 1e-8);
W = diag(1./var_est);
Theta_wls = (X'*W*X) \ (X'*W*Y);

L_est  = Theta_wls(1);
R_est  = Theta_wls(2);
ke_est = Theta_wls(3);

L_est  = Theta_ols(1);
R_est  = Theta_ols(2);
ke_est = Theta_ols(3);

fprintf('\n=== WLS electrical model ===\n');
fprintf('L  = %.6e H\n', L_est);
fprintf('R  = %.6e Ohm\n', R_est);
fprintf('ke = %.6e V/(rad/s)\n', ke_est);

%% ===================== Model reconstruction =====================
% Training set: v_hat = L*i_dot + R*i + ke*omega
v_hat_train = L_est*train_i_dot + R_est*train_i + ke_est*train_omega;

mse_train = mean((train_v - v_hat_train).^2);
fprintf('\nMSE (Training, electrical model): %.6f\n', mse_train);

% Test set
v_hat_test = L_est*test_i_dot + R_est*test_i + ke_est*test_omega;

mse_test = mean((test_v - v_hat_test).^2);
fprintf('MSE (Test, electrical model): %.6f\n', mse_test);

%% ===================== Publication-quality plots =====================
figure;
tiledlayout(2,1,'Padding','compact','TileSpacing','compact');

% ---- Training set ----
nexttile; hold on;
plot(train_v, 'LineWidth', 1.6);
plot(v_hat_train, '--', 'LineWidth', 2.0);

grid on; box on; axis tight;
xlabel('Samples');
ylabel('Voltage $v$ (V)');
title(sprintf('Training set (1 Hz) -- MSE = %.3e', mse_train));
legend({'Measured voltage','Reconstructed voltage'}, ...
       'Location','southeast','FontSize',defaultFontSize-2);
hold off;

% ---- Test set ----
nexttile; hold on;
plot(test_v, 'LineWidth', 1.6);
plot(v_hat_test, '--', 'LineWidth', 2.0);

grid on; box on; axis tight;
xlabel('Samples');
ylabel('Voltage $v$ (V)');
title(sprintf('Test set (2 Hz) -- MSE = %.3e', mse_test));
legend({'Measured voltage','Reconstructed voltage'}, ...
       'Location','southeast','FontSize',defaultFontSize-2);
hold off;

% ---- Save high quality ----
set(gcf, 'Units', 'inches', 'Position', [1, 1, 10, 6]);
exportgraphics(gcf, 'electrical_model_reconstruction_M1.png', 'Resolution', 300);

%% ===================== Additional diagnostic plot =====================
% Plot individual terms to understand contribution of each component

figure;
tiledlayout(3,1,'Padding','compact','TileSpacing','compact');

nexttile; hold on;
plot(L_est*train_i_dot, 'LineWidth', 1.4);
grid on; box on; axis tight;
xlabel('Samples');
ylabel('$L \cdot \dot{i}$ (V)');
title('Inductance term');
hold off;

nexttile; hold on;
plot(R_est*train_i, 'LineWidth', 1.4);
grid on; box on; axis tight;
xlabel('Samples');
ylabel('$R \cdot i$ (V)');
title('Resistance term');
hold off;

nexttile; hold on;
plot(ke_est*train_omega, 'LineWidth', 1.4);
grid on; box on; axis tight;
xlabel('Samples');
ylabel('$k_e \cdot \omega$ (V)');
title('Back-EMF term');
hold off;

set(gcf, 'Units', 'inches', 'Position', [1, 1, 10, 8]);
exportgraphics(gcf, 'electrical_model_terms_M1.png', 'Resolution', 300);

%% ===================== Print summary =====================
fprintf('\n========== SUMMARY ==========\n');
fprintf('Electrical equation: L*di/dt = v - R*i - ke*omega\n\n');
fprintf('Estimated parameters (WLS):\n');
fprintf('  Inductance L   = %.4e H\n', L_est);
fprintf('  Resistance R   = %.4e Ohm\n', R_est);
fprintf('  Back-EMF ke    = %.4e V/(rad/s)\n', ke_est);
fprintf('\nModel performance:\n');
fprintf('  Training MSE   = %.4e\n', mse_train);
fprintf('  Test MSE       = %.4e\n', mse_test);
fprintf('==============================\n');