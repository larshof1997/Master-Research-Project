    firstTarget		    22
  }
  chart {
    id			    2
    machine		    1
    name		    "MATLAB Function"
    windowPosition	    [422 539.941 189 413]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 3600 1200 1.180555555555556]
    treeNode		    [0 3 0 0]
    viewObj		    2
    visible		    1
    subviewS {
    }
    ssIdHighWaterMark	    37
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    2
    disableImplicitCasting  1
    eml {
      name		      "rascon_iet_controller_fcn"
    }
    firstData		    4
    firstTransition	    20
    firstJunction	    19
  }
  state {
    id			    3
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 0 0]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [u, z3_out] = ...\n    rascon_iet_controller_fcn(q, qd, dqd, ddqd, z3_in, dt, ...\n     "
      "                         a1, a2, bp, b1, b2, K1_scl, K2_scl)\n%#codegen\n% RASCON_IET_CONTROLLER_FCN  Rascon 202"
      "0 IET integral tracking controller.\n%\n%  SIMULINK MATLAB FUNCTION BLOCK - 2018b / Coder compatible.\n%\n%  Con"
      "trol law:\n%    z1    = q - qd\n%    tau_c = -K1*z1 - z3\n%    dz3   = -K1*z1 - K2*z3\n%    u     = M(q)*ddqd + "
      "C(q,dqd)*dqd + D0*dqd + tau_c    (gradV = 0)\n%\n%  HOW TO WIRE IN SIMULINK:\n%  1. Place a MATLAB Function bloc"
      "k, paste this code.\n%  2. Inputs:\n%       q, qd, dqd, ddqd : [2 1]\n%       z3_in             : [2 1]   (integ"
      "ral state, from Unit Delay IC=[0;0])\n%       dt                : [1 1]\n%       a1,a2,bp,b1,b2    : [1 1]   (pl"
      "ant parameters)\n%       K1_scl, K2_scl    : [1 1]   (scalar gains: K1 = K1_scl*I, K2 = K2_scl*I)\n%  3. Connect"
      " z3_out -> Unit Delay (IC=[0;0]) -> z3_in\n\n% ================================================================="
      "====\n%  OUTPUT INITIALIZATION\n% =====================================================================\nu      "
      "= zeros(2,1);\nud     = zeros(2,1);\nz3_out = zeros(2,1);\n\n% ================================================="
      "====================\n%  MAIN COMPUTATION\n% ==================================================================="
      "==\n\n% ---- Local copies ----\nq_c    = [q(1); q(2)];\nqd_c   = [qd(1); qd(2)];\ndqd_c  = [dqd(1); dqd(2)];\ndd"
      "qd_c = [ddqd(1); ddqd(2)];\nz3     = [z3_in(1); z3_in(2)];\n\n% ---- Gain matrices (diagonal, scalar * I) ----\n"
      "K1 = K1_scl;   % just the scalar, applied element-wise below\nK2 = K2_scl;\n\n% ---- Plant matrices ----\nM  = l"
      "oc_M(q_c(2), a1, a2, bp);\nD0 = [b1, 0; 0, b2];\nC  = loc_C(q_c(2), dqd_c(1), dqd_c(2), bp);\n\n% ---- Tracking "
      "error ----\nz1 = [q_c(1) - qd_c(1); q_c(2) - qd_c(2)];\n\n% ---- Control correction ----\ntau_c = [-(K1*z1(1) + "
      "z3(1));\n         -(K1*z1(2) + z3(2))];\n\n% ---- Feedforward (no gravity) ----\nM_ddqd = [M(1,1)*ddqd_c(1) + M("
      "1,2)*ddqd_c(2);\n          M(2,1)*ddqd_c(1) + M(2,2)*ddqd_c(2)];\nC_dqd  = [C(1,1)*dqd_c(1) + C(1,2)*dqd_c(2);\n"
      "          C(2,1)*dqd_c(1) + C(2,2)*dqd_c(2)];\nD_dqd  = [D0(1,1)*dqd_c(1); D0(2,2)*dqd_c(2)];\ntau_ff = M_ddqd +"
      " C_dqd + D_dqd;\n\n% ---- Total control (G0 = I) ----\nu = [tau_ff(1) + tau_c(1); tau_ff(2) + tau_c(2)];\n\n% --"
      "-- Nominal feedforward for comparison ----\nCd = loc_C(qd_c(2), dqd_c(1), dqd_c(2), bp);\nMd = loc_M(qd_c(2), a1"
      ", a2, bp);\nMd_ddqd = [Md(1,1)*ddqd_c(1) + Md(1,2)*ddqd_c(2);\n           Md(2,1)*ddqd_c(1) + Md(2,2)*ddqd_c(2)]"
      ";\nCd_dqd  = [Cd(1,1)*dqd_c(1) + Cd(1,2)*dqd_c(2);\n           Cd(2,1)*dqd_c(1) + Cd(2,2)*dqd_c(2)];\n\n% ---- z"
      "3 dynamics (RK4) ----\n%  dz3 = -K1*z1 - K2*z3\n%  z1 is held constant over the step (ZOH on position measuremen"
      "t)\nk1 = loc_dz3(z3,              z1, K1, K2);\nk2 = loc_dz3(z3 + 0.5*dt*k1, z1, K1, K2);\nk3 = loc_dz3(z3 + 0.5"
      "*dt*k2, z1, K1, K2);\nk4 = loc_dz3(z3 + dt*k3,     z1, K1, K2);\nz3_out = [z3(1) + (dt/6.0)*(k1(1) + 2.0*k2(1) +"
      " 2.0*k3(1) + k4(1));\n          z3(2) + (dt/6.0)*(k1(2) + 2.0*k2(2) + 2.0*k3(2) + k4(2))];\n\nend\n\n% ========="
      "================================================================\n%  LOCAL FUNCTIONS\n% ========================"
      "=================================================\n\nfunction M = loc_M(theta2, a1, a2, b)\n    c2 = cos(theta2)"
      ";\n    M = [a1 + a2 + 2*b*c2,  a2 + b*c2;\n         a2 + b*c2,          a2       ];\nend\n\nfunction C = loc_C(t"
      "heta2, dtheta1, dtheta2, b)\n    s2 = sin(theta2);\n    C = [-b*s2*dtheta2,           -b*s2*(dtheta1 + dtheta2);"
      "\n          b*s2*dtheta1,            0];\nend\n\nfunction dz = loc_dz3(z3, z1, K1, K2)\n    dz = [-(K1*z1(1) + K"
      "2*z3(1));\n          -(K1*z1(2) + K2*z3(2))];\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
