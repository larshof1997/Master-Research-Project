    eml {
      isEML		      1
      script		      "function u_ff = feedforward(out, pd_k, dpd_dq, phat_k, ddqd_k, gradV, v_k)\n    % --- Feedforward"
      " ---\n    u_ff = out.G \\ ( ...\n        -(out.S - out.D) * pd_k ...\n        + out.T * gradV(q_k') ...\n       "
      " + dpd_dq * (out.T * phat_k(:)) ...\n        + out.Ti * ddqd_k ...\n        + v_k);\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
