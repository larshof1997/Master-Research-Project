    eml {
      name		      "observer_matrices"
    }
    firstData		    31
    firstTransition	    38
    firstJunction	    37
  }
  state {
    id			    30
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    29
    treeNode		    [29 0 0 0]
    superState		    SUBCHART
    subviewer		    29
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function out = observer_matrices(q, phat, M, D, G)\n    q = q(:);  phat = phat(:);\n    % Better:"
      " pass mass_fn as argument. Keeping minimal for clarity.\n    T  = sym_sqrt(inv(M));\n    Ti = sym_sqrt(M);\n\n  "
      "  out.D = T * D0 * T;\n    out.G = T * G0;\n    out.T = T;\n    out.Ti = Ti;\n\n    s2 = sin(q(2));\n    dM_dq2 "
      "= [-2*b*s2, -b*s2; -b*s2, 0];\n    dTi_dq2 = sylvester(Ti, Ti, dM_dq2);\n\n    A = [zeros(2,1), dTi_dq2 * phat];"
      "\n    out.S = T * (A' - A) * T;\n\n    Sbar = zeros(2);\n    for i = 1:2\n        ei = zeros(2,1); ei(i) = 1;\n "
      "       A_ei = [zeros(2,1), dTi_dq2 * ei];\n        S_ei = T * (A_ei' - A_ei) * T;\n        Sbar(:,i) = S_ei * ph"
      "at;\n    end\n    out.Sbar = Sbar;\nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
