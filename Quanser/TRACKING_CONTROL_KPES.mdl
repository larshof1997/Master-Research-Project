    eml {
      isEML		      1
      script		      "function v_k = KPES(out, Kd, Kp, alpha, qe, pe)\n    z = qe + alpha * pe;\n    v_k = alpha * (out"
      ".S - out.D - Kd) * Kp * z ...\n        - out.T * Kp * z ...\n        - Kd * pe;\n\n\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
