  state {
    id			    41
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    40
    treeNode		    [40 0 0 0]
    superState		    SUBCHART
    subviewer		    40
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [xp, phi, phat_k] = switch_logic(xp, phi, phat_k, q_k, out, kappa)\n    while (min(eig(p"
      "hi*out.T_mat - 0.5*(out.Sbar + out.Sbar'))) - kappa) <= 0\n        xp     = xp - kappa * q_k;\n        phi    = "
      "phi + kappa;\n        phat_k = xp + phi*q_k;\n    end\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
