  state {
    id			    85
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    84
    treeNode		    [84 0 0 0]
    superState		    SUBCHART
    subviewer		    84
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function uo_k = passive_output(Kp, qe, pe, alpha, out, dpd_dq)\n    % --- Passive output from tra"
      "cking error ---\n    dHe_dqe = Kp * (qe + alpha * pe);\n    dHe_dpe = pe_k + alpha * Kp * (qe_k + alpha * pe);\n"
      "    ye_k = -out.T * [eye(2), phi*eye(2) - dpd_dq'] * [dHe_dqe; dHe_dpe];\n    \n    uo_k = -out.G \\ ye_k;\n\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
